# Circuito de prueba grande: 9 entradas y 38 compuertas (512 filas).
# Sumador ripple de 4 bits + multiplicador 2x2 + reduction de salidas.
ENTRADA[a0, a1, a2, a3, b0, b1, b2, b3, cin]
XOR[a0, b0] -> x0
XOR[x0, cin] -> s0
AND[a0, b0] -> p0
AND[cin, x0] -> g0
OR[p0, g0] -> c1
XOR[a1, b1] -> x1
XOR[x1, c1] -> s1
AND[a1, b1] -> p1
AND[c1, x1] -> g1
OR[p1, g1] -> c2
XOR[a2, b2] -> x2
XOR[x2, c2] -> s2
AND[a2, b2] -> p2
AND[c2, x2] -> g2
OR[p2, g2] -> c3
XOR[a3, b3] -> x3
XOR[x3, c3] -> s3
AND[a3, b3] -> p3
AND[c3, x3] -> g3
OR[p3, g3] -> c4
AND[a0, b0] -> m00
AND[a0, b1] -> m01
AND[a1, b0] -> m10
AND[a1, b1] -> m11
XOR[m01, m10] -> r1
AND[m01, m10] -> ac
XOR[ac, m11] -> r2
AND[ac, m11] -> r3
XOR[r2, s0] -> paridad
XNOR[c4, r3] -> acarreo_seguro
AND[ac, m01] -> medio
OR[medio, r1] -> medio2
XOR[medio2, s1] -> digito1
NAND[s2, s3] -> control
NOR[control, r2] -> control2
XOR[control2, digito1] -> digito2
XNOR[digito2, paridad] -> digito3
XOR[digito3, acarreo_seguro] -> salida
